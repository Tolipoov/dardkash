# PostgreSQL (Docker konteyneri dardkash-db uchun)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=dardkash

# Backend (server/) uchun DATABASE_URL:
# - Docker orqali ishga tushirganda docker-compose.yml buni o'zi quradi
#   (host nomi "dardkash-db"), shuning uchun bu yerda qo'lda yozish shart emas.
# - Docker'siz, to'g'ridan-to'g'ri "cd server && npm run dev" bilan ishga
#   tushirganda, host "localhost" bo'lishi kerak:
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/dardkash

# JWT sessiya kaliti (dardkash_session cookie) — istalgan uzun tasodifiy matn
JWT_SECRET=

# Backend qaysi manzilda ishlayotgani (CORS va OAuth redirect uchun)
# Lokal: http://localhost:3000   Production: https://dardkash.uz
APP_BASE_URL=

# Google OAuth (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Masalan lokalda: http://localhost:4000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Telegram Login Widget
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Frontend'da widget skriptiga uzatiladi (NEXT_PUBLIC_ prefiksi shart)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# LiveKit (self-hosted)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Backend porti (ixtiyoriy, standart 4000)
PORT=4000

# Frontend va backend ALOHIDA portlarda ishlaganda (masalan "npm run dev"
# bilan frontend :3000'da, backend :4000'da; yoki hatto docker-compose
# orqali lokal — u yerda ham nginx yo'q, web va api turli portlarda) —
# frontend'ning nisbiy "/api/..." so'rovlari to'g'ridan-to'g'ri Next.js
# serverining o'ziga tushib, 404 qaytaradi. Shu holatlar uchun quyidagini
# to'ldiring (backend qaysi manzilda turgan bo'lsa, o'shani yozing):
# NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
#
# Production'da BO'SH QOLDIRING — u yerda nginx bitta domenda frontend va
# backend'ni birlashtiradi (deploy/dardkash.uz.conf), shuning uchun bu
# o'zgaruvchi kerak emas.
NEXT_PUBLIC_API_ORIGIN=
